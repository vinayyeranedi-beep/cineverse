rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders:
    // Cinema seat patrons create their order from mobile QR code
    // Kitchen staff and delivery runners track and update orders in real time across any device
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Menu Items: Customers browse food & drinks, Admins manage menu
    match /menuItems/{menuItemId} {
      allow read, write: if true;
    }

    // Screens: Cinema auditorium configuration (screens 1, 2, 3)
    match /screens/{screenId} {
      allow read, write: if true;
    }

    // Staff Accounts
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Support and Issue Tickets
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}

